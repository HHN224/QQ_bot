# 复制为 .env 后填写。不要提交 .env。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SCREENING_MODEL=gpt-4.1-mini
FINAL_MODEL=gpt-4.1

# 月度预算上限（人民币）。达到上限后停止云端模型调用。
MONTHLY_BUDGET_CNY=30

# 按供应商账单填写，用于估算费用；未知时可暂时保留 0。
INPUT_PRICE_CNY_PER_MILLION=0
OUTPUT_PRICE_CNY_PER_MILLION=0

RETENTION_DAYS=30
MODEL_TIMEOUT_SECONDS=60
MAX_INPUT_CHARS=120000

# 没有 API Key 时允许本地规则生成演示结果，便于验证端到端流程。
ALLOW_LOCAL_FALLBACK=true
